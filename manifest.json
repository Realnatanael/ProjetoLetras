{
  "manifest_version": 3,
  "name": "Projeto Letras",
  "version": "1.2.2",
  "description": "Mostra a letra no tempo do Apple Music por cima do vídeo do YouTube.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": [
    "https://music.apple.com/*",
    "https://www.youtube.com/*",
    "https://lrclib.net/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Projeto Letras",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["apple-music-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["apple-music-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
